
# ── Public web studio (`tabligh web` / the tabligh-web service) ───────────
# Everything here is OPTIONAL — the defaults are safe for a small VPS. This
# app is anonymous and render-only: it can never publish to your accounts.
WEB_PORT=1999
# Simultaneous renders. Each pins a Chrome + an ffmpeg, so 1 is right for a
# 2–4 core box. Raising it past your core count makes every job slower.
WEB_CONCURRENCY=1
# Refuse new jobs past this queue depth rather than promise a 40-minute wait.
WEB_QUEUE_MAX=20
# The single biggest lever on cost: a reel is rendered frame by frame.
WEB_MAX_AYAHS=10
WEB_MAX_DURATION=90
# Finished MP4s (and their job records) are deleted this long after rendering.
WEB_JOB_TTL_MINUTES=60
# Per-IP throttling.
WEB_RATE_PER_HOUR=5
WEB_MAX_ACTIVE_PER_IP=1
# Honour X-Forwarded-For. Enable ONLY behind a proxy you control, otherwise
# any visitor can spoof their IP and bypass the rate limit.
WEB_TRUST_PROXY=false
# Shown in the UI (star button, self-host links).
WEB_GITHUB_REPO=911RS/tabligh
# Optional Cloudflare Turnstile. Leave both empty to run without a captcha.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ── Public site identity ─────────────────────────────────────────────────
# Canonical origin for SEO (canonical/hreflang/sitemap/OG URLs), and the
# address shown in the outro of every rendered reel.
SITE_URL=https://tabligh.cc
