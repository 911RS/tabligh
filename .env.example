# ── Quran data ────────────────────────────────────────────────────────────
# alquran.cloud is keyless. Base URLs are overridable in case of mirrors.
QURAN_API_BASE=https://api.alquran.cloud/v1
EVERYAYAH_BASE=https://everyayah.com/data

# ── Backgrounds (reused from 9at3a-api naming) ────────────────────────────
# CK2 = Pexels API key, CK3 = Unsplash Access Key
CK2=your-pexels-api-key
CK3=your-unsplash-access-key

# ── Rendering ─────────────────────────────────────────────────────────────
# Leave empty in dev (Puppeteer downloads its own Chromium).
# In Docker set to /usr/bin/chromium-browser.
PUPPETEER_EXECUTABLE_PATH=
# Optional background soundtrack dir (ambient bed under recitation). Empty = none.
SOCIAL_SOUNDS_DIR=

# ── Buffer (TikTok auto-post) ─────────────────────────────────────────────
# CK8 = Buffer GraphQL OIDC access token (from 9at3a-api setup)
CK8=your-buffer-token
# Comma-separated Buffer channel ids to post to (TikTok channel id)
BUFFER_TIKTOK_CHANNEL_IDS=

# ── MinIO (public host for Buffer to fetch the video) ─────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET_NAME=quran-poster
MINIO_PUBLIC_URL=https://storage.example.com

# ── Scheduler (serve mode) ────────────────────────────────────────────────
# Timezone for the schedule and times of day to auto-publish (3×/day).
TZ=Africa/Tunis
PUBLISH_TIMES=07:00,13:00,19:00
# Watermark handle fallback (used only if assets/logo.png is absent)
WATERMARK_HANDLE=
# HTTP port for the serve process (Coolify routes the app domain here)
PORT=3000
# Secret for the temporary manual test endpoint: GET /trigger?key=<token>
# (publishes by default; add &publish=false for render-only). Empty = disabled.
TRIGGER_TOKEN=

# ── Behaviour ─────────────────────────────────────────────────────────────
# Days to keep local work/ output before prune cleanup
RETENTION_DAYS=7
# Hours to keep uploaded videos on MinIO after publish (Buffer needs time to ingest)
MINIO_RETENTION_HOURS=24
# Instant MinIO delete on publish (risky — Buffer may not have fetched yet)
DELETE_MINIO_ON_PUBLISH=false
# Surahs with this many ayahs or fewer render in FULL (ignore the requested range).
FULL_SURAH_MAX_AYAHS=7
# random mode: consecutive ayah run length bounds (full surah if <= FULL_SURAH_MAX_AYAHS)
RANDOM_MIN_AYAHS=5
RANDOM_MAX_AYAHS=10
