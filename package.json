{
  "name": "quran-poster",
  "version": "0.1.0",
  "private": true,
  "description": "Auto-generate synced Quran reels and publish to TikTok via Buffer",
  "type": "module",
  "bin": {
    "quran-poster": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "fetch": "tsx src/cli.ts fetch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "minio": "^8.0.6",
    "puppeteer": "^24.40.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
