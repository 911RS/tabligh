# These values SEED the config store on first run. After that, manage everything
# live in the control panel (http://localhost:PORT) — env changes are ignored once
# the store exists. Delete data/store.json to re-seed from this file.

# ── Backgrounds (stock photos) ────────────────────────────────────────────
# At least one is recommended; without them the reels fall back to gradients.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# ── Rendering ─────────────────────────────────────────────────────────────
# Leave empty to use Puppeteer's bundled Chrome (recommended). Set a path only
# if you want to use a specific Chrome/Chromium binary.
PUPPETEER_EXECUTABLE_PATH=
# Karaoke word-by-word fill synced to the recitation (default true).
KARAOKE_ENABLED=true
# Color of the already-recited (filled) text; unfilled stays dim white. Default #ffffff.
TEXT_FILL_COLOR=

# ── Publishing via Buffer (TikTok / Instagram / Facebook / YouTube) ───────
# Create a Buffer account, connect your channels, then run `npm start channels`
# to list channel ids. Fill in the platforms you want; leave the rest empty.
BUFFER_ACCESS_TOKEN=
BUFFER_TIKTOK_CHANNEL_IDS=
BUFFER_INSTAGRAM_CHANNEL_IDS=
BUFFER_FACEBOOK_CHANNEL_IDS=
BUFFER_YOUTUBE_CHANNEL_IDS=

# ── Object storage (public URL Buffer fetches the video from) ─────────────
# Any S3-compatible store works (MinIO, etc.). The bucket is made public-read.
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=tabligh
MINIO_PUBLIC_URL=https://storage.example.com

# ── Scheduler (serve mode) ────────────────────────────────────────────────
TZ=Africa/Tunis
PUBLISH_TIMES=07:00,13:00,19:00

# ── Branding ──────────────────────────────────────────────────────────────
# Top-right corner watermark (uses assets/logo.png, or WATERMARK_HANDLE text).
WATERMARK_ENABLED=true
WATERMARK_HANDLE=
# Outro sign-off text shown centered as the video fades to black (Kufi).
# Defaults to a ṣalawāt; set your own or leave to use the default.
OUTRO_TEXT=
# Drifting particle glints and animated background zoom.
PARTICLES_ENABLED=true
BG_ANIMATION=true
# Show the "Check the Tabligh project" line in the outro (the github link is always shown).
PROJECT_CREDIT=true

# ── Content selection ─────────────────────────────────────────────────────
# Surahs with this many ayahs or fewer render in FULL (ignore the range). 0=off.
FULL_SURAH_MAX_AYAHS=7
# `random`/`auto` mode: length bounds of the consecutive ayah run from long surahs.
RANDOM_MIN_AYAHS=5
RANDOM_MAX_AYAHS=10
# Cap recitation length (excluding outro), seconds. Trims trailing ayahs to fit
# (overrides the min-ayah floor). 0 = no limit.
MAX_VIDEO_SECONDS=0

# ── Control panel ─────────────────────────────────────────────────────────
# Where the config store is persisted (mount this path as a volume to keep it).
STORE_PATH=

# ── Cleanup ───────────────────────────────────────────────────────────────
RETENTION_DAYS=7               # keep local work/ output this many days
MINIO_RETENTION_HOURS=24       # keep uploaded videos this long (Buffer ingest window)
DELETE_MINIO_ON_PUBLISH=false  # instant MinIO delete (risky — Buffer may not have fetched)

# ── HTTP server (serve mode) ──────────────────────────────────────────────
PORT=3000
# Secret for the manual test endpoint GET /trigger?key=<token> (empty = disabled).
TRIGGER_TOKEN=
