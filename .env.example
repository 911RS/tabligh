# These values SEED the config store on first run. After that, manage everything
# live in the control panel (http://localhost:PORT) — env changes are ignored once
# the store exists. Delete data/store.json to re-seed from this file.

# ── Backgrounds ───────────────────────────────────────────────────────────
# Where background images come from:
#   auto     – Pexels, then Unsplash (default)
#   pexels   – Pexels only
#   unsplash – Unsplash only
#   local    – a folder of your own portrait images (BACKGROUND_LOCAL_DIR)
BACKGROUND_SOURCE=auto
# Used only when BACKGROUND_SOURCE=local. Point at a folder of portrait
# .jpg/.png/.webp images; one is picked per reel (no attribution shown).
BACKGROUND_LOCAL_DIR=
# Prepend the reciter's own Bismillah (Fatiha 1:1) before a passage:
#   off    – only when the passage starts at ayah 1 (this rule always applies)
#   always – before every passage
# (At-Tawbah and Al-Fatiha's own opening are handled automatically.)
BASMALA=off
# For auto/pexels/unsplash: at least one key is recommended, else reels fall
# back to gradients.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# ── Rendering ─────────────────────────────────────────────────────────────
# Leave empty to use Puppeteer's bundled Chrome (recommended). Set a path only
# if you want to use a specific Chrome/Chromium binary.
PUPPETEER_EXECUTABLE_PATH=
# Visual template for the reel: classic | glass | noor.
#   classic – photo + dark scrim + centered ayah (the original look)
#   glass   – one persistent frosted glass card with a live audio waveform
#   noor    – warm "Divine Light": golden halo + gilded numerals
TEMPLATE=classic
# Karaoke word-by-word fill synced to the recitation (default true).
KARAOKE_ENABLED=true
# Color of the already-recited (filled) text; unfilled stays dim white. Default #ffffff.
TEXT_FILL_COLOR=

# ── Publishing via Buffer (TikTok / Instagram / Facebook / YouTube) ───────
# Create a Buffer account, connect your channels, then run `npm start channels`
# to list channel ids. Fill in the platforms you want; leave the rest empty.
BUFFER_ACCESS_TOKEN=
BUFFER_TIKTOK_CHANNEL_IDS=
BUFFER_INSTAGRAM_CHANNEL_IDS=
BUFFER_FACEBOOK_CHANNEL_IDS=
BUFFER_YOUTUBE_CHANNEL_IDS=

# ── Object storage (public URL Buffer fetches the video from) ─────────────
# Any S3-compatible store works (MinIO, etc.). The bucket is made public-read.
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=tabligh
MINIO_PUBLIC_URL=https://storage.example.com

# ── Scheduler (serve mode) ────────────────────────────────────────────────
TZ=Africa/Tunis
PUBLISH_TIMES=07:00,13:00,19:00

# ── Branding ──────────────────────────────────────────────────────────────
# Top-right corner watermark (uses assets/logo.png, or WATERMARK_HANDLE text).
WATERMARK_ENABLED=true
WATERMARK_HANDLE=
# The outro sign-off is a fixed ṣalawāt (blessing on the Prophet ﷺ) and is not
# configurable by design.
# Drifting particle glints and animated background zoom.
PARTICLES_ENABLED=true
BG_ANIMATION=true
# Show the "Check the Tabligh project" line in the outro (the github link is always shown).
PROJECT_CREDIT=true

# ── Content selection ─────────────────────────────────────────────────────
# Surahs with this many ayahs or fewer render in FULL (ignore the range). 0=off.
FULL_SURAH_MAX_AYAHS=7
# `random`/`auto` mode: length bounds of the consecutive ayah run from long surahs.
RANDOM_MIN_AYAHS=5
RANDOM_MAX_AYAHS=10
# Cap recitation length (excluding outro), seconds. Trims trailing ayahs to fit
# (overrides the min-ayah floor). 0 = no limit.
MAX_VIDEO_SECONDS=0

# ── Control panel ─────────────────────────────────────────────────────────
# Where the config store is persisted (mount this path as a volume to keep it).
STORE_PATH=

# ── Cleanup ───────────────────────────────────────────────────────────────
RETENTION_DAYS=7               # keep local work/ output this many days
MINIO_RETENTION_HOURS=24       # keep uploaded videos this long (Buffer ingest window)
DELETE_MINIO_ON_PUBLISH=false  # instant MinIO delete (risky — Buffer may not have fetched)

# ── HTTP server (serve mode) ──────────────────────────────────────────────
PORT=1998
# Secret for the manual test endpoint GET /trigger?key=<token> (empty = disabled).
TRIGGER_TOKEN=
# Set to false (or run `tabligh serve --no-panel`) to run headless — the
# scheduler still posts, but no control-panel HTTP surface is exposed.
PANEL_ENABLED=true

# ── Interactive terminal menu ─────────────────────────────────────────────
# Language for the `tabligh` command center menu: en | ar | fr.
# (Post captions localize separately from the translation edition.)
UI_LANG=en

# ── Control panel ────────────────────────────────────────────────────────────
# The panel binds to loopback by default, so it is NOT reachable from the
# internet. To reach it, either tunnel:
#     ssh -L 1998:127.0.0.1:1998 you@server
# or put a reverse proxy in front of it (the proxy connects over loopback).
#
# To expose the port directly instead, set the password HERE first and then set
# PANEL_HOST=0.0.0.0. Setting the password is what makes that safe: the reason a
# reachable panel is dangerous is the first-run setup screen, which hands the
# panel to whoever loads it first. With a password already set there is no setup
# screen to claim.
#
# This does NOT protect the password in transit — the panel speaks plain HTTP,
# so put TLS in front of it before exposing it to the internet.
PANEL_PASSWORD=
PANEL_HOST=127.0.0.1
